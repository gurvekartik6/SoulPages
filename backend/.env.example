PORT=5000
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRATION=86400
CORS_ORIGIN=http://localhost:5173

# --- Database ---
# Local Postgres (see backend/README.md for setup):
DATABASE_URL=postgresql://booktracker:booktracker_dev_pw@localhost:5432/booktracker

# Supabase: Project Settings → Database → Connection string → URI
# (use the "Transaction" pooler connection on port 6543 for serverless hosts,
# or the direct "Session" connection on 5432 otherwise). Example shape:
# DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres

# Set to "false" to disable SSL (default: on unless DATABASE_URL points at
# localhost/127.0.0.1, since Supabase and most managed Postgres require it).
# PGSSL=true
